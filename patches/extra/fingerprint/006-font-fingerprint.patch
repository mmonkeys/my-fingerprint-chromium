+// 获取命令行参数
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  if (command_line->HasSwitch(switches::kFingerprint) &&
+      creation_params.CreationType() == kCreateFontByFamily) {
+    // 定义基础字体数组，避免exit-time destructors警告
+    static const char* basic_fonts[] = {"Arial", "Times New Roman",
+                                        "Courier New", "Georgia", "Verdana", "Microsoft YaHei", "SimSun"};
+    static const size_t basic_fonts_count =
+        sizeof(basic_fonts) / sizeof(basic_fonts[0]);
+
+    String current_font = creation_params.Family();
+
+    // 检查是否是基础字体
+    bool is_basic_font = false;
+    for (size_t i = 0; i < basic_fonts_count; i++) {
+      if (current_font == basic_fonts[i]) {
+        is_basic_font = true;
+        break;
+      }
+    }
+
+    // 只对非基础字体进行处理
+    if (!is_basic_font) {
+      std::string fingerprint =
+          command_line->GetSwitchValueASCII(switches::kFingerprint);
+      uint32_t seed;
+      if (base::StringToUint(fingerprint, &seed)) {
+        // 定义静态变量
+        static uint32_t processed_font_hashes[10000] = {0};
+        static int processed_count = 0;
+        static bool initialized = false;
+
+        // 为当前字体生成哈希值
+        uint32_t current_font_hash = std::hash<String>{}(current_font);
+
+        // 一次性初始化配置
+        if (!initialized) {
+          initialized = true;
+        }
+
+        // 检查字体是否已处理过
+        bool font_processed = false;
+        for (int i = 0; i < processed_count; i++) {
+          if (processed_font_hashes[i] == current_font_hash) {
+            font_processed = true;
+            break;
+          }
+        }
+
+        // 处理新发现的字体
+        if (!font_processed && processed_count < 10000) {
+          // 添加到已处理列表
+          processed_font_hashes[processed_count++] = current_font_hash;
+
+          // 计算确定性分数 - 使用fingerprint作为种子确保对相同字体产生相同结果
+          uint32_t font_score =
+              (current_font_hash ^ seed) % 10000;  // 得分范围0-9999
+
+          // 如果分数在前10%（分数小于1000），则屏蔽此字体
+          if (font_score < 1000) {  // 10% = 1000/10000
+            return nullptr;  // 屏蔽此字体
+          }
+        }
+      }
+    }
+  }
+
